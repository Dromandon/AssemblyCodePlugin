    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "floorSurface;\nwallsTIFS;\nwallsBL;\nwallsTL;\n\n//Фильтрую стены, которые пересекают больше двух плит или не пересекают их.\nwallGeo = BoundingBox.ToCuboid(Element.BoundingBox(wallsTIFS));\nbool1 = Geometry.DoesIntersect(floorSurface<2>, wallGeo<1>);\nbool2 = List.CountTrue(bool1@L2<1>) != 1;\nfilterWalls1 = List.FilterByBoolMask(wallsTIFS, bool2);\nfilterBL1 = List.FilterByBoolMask(wallsBL, bool2);\nfilterTL1 = List.FilterByBoolMask(wallsTL, bool2);\nwallsToInspectFurther = Dictionary.ValueAtKey(filterWalls1, \"in\");\nwallsToInspectFurtherBL = Dictionary.ValueAtKey(filterBL1, \"in\");\nwallsToInspectFurtherTL = Dictionary.ValueAtKey(filterTL1, \"in\");\nwallsToInspect = Dictionary.ValueAtKey(filterWalls1, \"out\");\n\nbool0 = List.CountTrue(bool1@L2<1>) == 0;\nboolGreater1 = List.CountTrue(bool1@L2<1>) > 1;\nfilterWalls0 = List.FilterByBoolMask(wallsTIFS, bool0);\nfilterWallsBL0 = List.FilterByBoolMask(wallsBL, bool0);\nfilterWallsTL0 = List.FilterByBoolMask(wallsTL, bool0);\nwallsIntercested0 = Dictionary.ValueAtKey(filterWalls0, \"in\");\n\nfilterWallsGreater1 = List.FilterByBoolMask(wallsTIFS, boolGreater1);\nfilterWallsBLGreater1 = List.FilterByBoolMask(wallsBL, boolGreater1);\nfilterWallsTLGreater1 = List.FilterByBoolMask(wallsTL, boolGreater1);\n\nwallsIntercestedGreater1 = Dictionary.ValueAtKey(filterWallsGreater1, \"in\");\nwallsBLGreater1 = Dictionary.ValueAtKey(filterWallsBLGreater1, \"in\");\nwallsTLGreater1 = Dictionary.ValueAtKey(filterWallsTLGreater1, \"in\");\n\n//Определю, является пересечение стены пересечением или только косанием.\n//Если косание, то определеяю с какой стороны (верх или низ)\n//В зависимости от места соприкосновения определяю выше или ниже нуля стена\nwallsToInspectGeo = BoundingBox.ToCuboid(Element.BoundingBox(wallsToInspect));\npMin = BoundingBox.MinPoint(Element.BoundingBox(wallsToInspect));\npMax = BoundingBox.MaxPoint(Element.BoundingBox(wallsToInspect));\nintersectionGeo = Geometry.Intersect(floorSurface<2>, wallsToInspectGeo<1>);\nintersectionGeoClean = List.Clean(intersectionGeo@L1<1>, true);\npoint1 = Surface.PointAtParameter(intersectionGeoClean, 0.5, 0.5)==null?Curve.PointAtParameter(intersectionGeoClean, 0.5):Surface.PointAtParameter(intersectionGeoClean, 0.5, 0.5);\n//point1 = Surface.PointAtParameter(intersectionGeoClean, 0.5, 0.5);\nplane1 = Plane.ByOriginNormal(point1, Vector.ZAxis());\nboolBB = List.Flatten(BoundingBox.Contains(Element.BoundingBox(wallsToInspect), point1),-1);\nbool3 = List.Flatten(boolBB && Geometry.DistanceTo(pMin, plane1)<1,-1);\nbool4 = List.Flatten(boolBB && Geometry.DistanceTo(pMax, plane1)<1,-1);\n\n//filter 2 - если стена не подходит к данному условию, то её надо рассечь\n//filter 3 и 4 - определяю выше или ниже нуля стена\nfilter2 = List.FilterByBoolMask(wallsToInspect, (bool3 || bool4));\nfilter3 = List.FilterByBoolMask(wallsToInspect, bool3);\nfilter4 = List.FilterByBoolMask(wallsToInspect, bool4);\n\nwallsToSplit = Dictionary.ValueAtKey(filter2, \"out\");\nwallsToWarning = List.Flatten([wallsToSplit,wallsIntercested0], -1);\nwallsAboveZero2 = Dictionary.ValueAtKey(filter3, \"in\");\nwallsBelowZero2 = Dictionary.ValueAtKey(filter4, \"in\");",
      "Id": "db7e88558ef94e46b4ae57d93864e1c9",
      "Inputs": [
        {
          "Id": "2daede48748f4ecfbe9cc00ec181b7d1",
          "Name": "floorSurface",
          "Description": "floorSurface",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a34c6bddf85249df97354e52fab84fb8",
          "Name": "wallsTIFS",
          "Description": "wallsTIFS",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "efe1cec6f4004ef39e1b3263d6addc55",
          "Name": "wallsBL",
          "Description": "wallsBL",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
