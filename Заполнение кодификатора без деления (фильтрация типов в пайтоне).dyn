    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "floorSurface;\n\ncolumnsTIFS;\ncolumnLines;\n\n//Фильтрую колонны, которые пересекают больше двух плит или не пересекают их.\n\nbool1 = Geometry.DoesIntersect(floorSurface<2>, columnLines<1>);\nbool2 = List.CountTrue(bool1@L2<1>) != 1;\nfilter1 = List.FilterByBoolMask(columnsTIFS, bool2);\nfilter2 = List.FilterByBoolMask(columnLines, bool2);\ncolumnsToRepair = Dictionary.ValueAtKey(filter1, \"in\");\ncolumnsToInspect = Dictionary.ValueAtKey(filter1, \"out\");\n\n//Определю, является пересечение линий колонн пересечением или только косанием.\n//Если косание, то определеяю с какой стороны (верх или низ)\n//В зависимости от места соприкосновения определяю выше или ниже нуля колонна\ncolumnsToInspectLines = Dictionary.ValueAtKey(filter2, \"out\");\npMin = Line.StartPoint(columnsToInspectLines);\npMax = Line.EndPoint(columnsToInspectLines);\nintersectionGeo = Geometry.Intersect(floorSurface<2>, columnsToInspectLines<1>);\nintersectionGeoClean =List.Flatten(List.Clean(intersectionGeo@L1<1>, true), -1);\nplane1 = Plane.ByOriginNormal(intersectionGeoClean, Vector.ZAxis());\nbool3 = Geometry.DistanceTo(pMin, plane1)<1;\nbool4 = Geometry.DistanceTo(pMax, plane1)<1;\n\n//filter 3 - если колонна не подходит к данному условию, то её надо рассечь\n//filter 4 и 5 - определяю выше или ниже нуля стена\nfilter3 = List.FilterByBoolMask(columnsToInspect, (bool3 || bool4));\nfilter4 = List.FilterByBoolMask(columnsToInspect, bool3);\nfilter5 = List.FilterByBoolMask(columnsToInspect, bool4);\n\ncolumnsToSplit = Dictionary.ValueAtKey(filter3, \"out\");\ncolumnsAboveZero2 = Dictionary.ValueAtKey(filter4, \"in\");\ncolumnsBelowZero2 = Dictionary.ValueAtKey(filter5, \"in\");",
      "Id": "108fe8a1a1364ddfb85035bab4526e07",
      "Inputs": [
