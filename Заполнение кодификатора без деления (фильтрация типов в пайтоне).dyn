      "NodeType": "PythonScriptNode",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\nkeys = IN[0]\r\nvalues = IN[1]\r\nwordsList = IN[2]\r\nmyKeys = []\r\nmyValues = []\r\nmyRating = []\r\nk=0\r\n\r\nfor words in wordsList:\r\n\t\r\n\tboolNoKey = True\r\n\tmyKeysTemp = []\r\n\tmyValuesTemp = []\r\n\tmyRatingTemp = []\r\n\tratingMax=0\r\n\tfor i in xrange(len(values)):\r\n\t\r\n\t\tbool1 = any([w.ToLower() in values[i].ToLower() for w in words.get(\"anyTrue\")])\r\n\t\tif len(words.get(\"anyTrue\"))<1:\r\n\t\t\tbool1=True\t\r\n\t\t\r\n\t\tbool2 = all([w.ToLower() in values[i].ToLower() for w in words.get(\"allTrue\")])\r\n\t\tif len(words.get(\"allTrue\"))<1:\r\n\t\t\tbool2=True\r\n\t\t\t\r\n\t\tbool3 = any([w.ToLower() in values[i].ToLower() for w in words.get(\"exceptions\")])\r\n\t\tif len(words.get(\"exceptions\"))<1:\r\n\t\t\tbool3=False\r\n\t\t\r\n\t\trating=1\t\r\n\t\tfor w in words.get(\"extraTrue\"):\r\n\t\t\tif w.keys()[0].ToLower() in values[i].ToLower():\r\n\t\t\t\trating=rating+w.values()[0]\t\r\n\t\t#rating=rating+sum([w.values()[0] for w in words.get(\"extraTrue\") if w.keys()[0].ToLower() in values[i].ToLower()]):\r\n\t\t\r\n\t\tif bool1 and bool2 and not bool3 and rating>=ratingMax:\r\n\t\t\tif ratingMax==0:\r\n\t\t\t\tmyKeysTemp.append(keys[i])\r\n\t\t\t\tmyValuesTemp.append(values[i])\r\n\t\t\telif rating == ratingMax:\r\n\t\t\t\tmyKeysTemp.append(keys[i])\r\n\t\t\t\tmyValuesTemp.append(values[i])\r\n\t\t\telse:\r\n\t\t\t\tmyKeysTemp=[keys[i]]\r\n\t\t\t\tmyValuesTemp=[values[i]]\r\n\t\t\tboolNoKey = False\r\n\t\t\tratingMax = rating\r\n\tif boolNoKey:\r\n\t\tk=k+1\r\n\t\tmyKeysTemp.append(\"No Key \"+str(k))\r\n\t\tmyValuesTemp.append(\"No Value \"+str(k))\r\n\tmyKeys.append(myKeysTemp)\r\n\tmyValues.append(myValuesTemp)\r\n\r\n# Place your code below this line\r\n\r\n# Assign your output to the OUT variable.\r\nOUT = [myKeys, myValues]",
