    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\nimport System\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitAPIUI')\r\nfrom Autodesk.Revit.DB import *\r\nimport Autodesk\r\n\r\nPName = IN[0]\r\n\r\nbips = System.Enum.GetValues(BuiltInParameter)\r\nfor bip in bips:\r\n  try:\r\n    parNames = LabelUtils.GetLabelFor(bip)\r\n    if PName == bip.ToString():\r\n      parName = parNames\r\n  except:\r\n    pass\r\ntry:\r\n  OUT = parName\r\nexcept: \r\n  OUT = \"Такой херни в базе нету)\"",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "2116c0dd130d475fa112154f65c8b575",
      "Inputs": [
        {
          "Id": "f6040e45ab7b4dcaa7089a7c722bb27c",
