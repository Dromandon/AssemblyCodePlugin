    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "wType = walls.GetParameterValueByName(Apex.ParameterName(\"ELEM_TYPE_PARAM\"));\n\nwParameter1 = Element.GetParameterValueByName(walls, \"FAM_Underground\");\nwParameter2 = Element.GetParameterValueByName(wType, \"FAM_Underground\");\nwFAM_Undeground = wParameter1 == \"\"? wParameter2: wParameter1;\n\nwBoolNo1 = wFAM_Undeground == \"Нет\";\nwBoolNo2 = wFAM_Undeground == \"No\";\nwBoolNo3 = wFAM_Undeground == text_FAM_UndergroundUP;\nwBoolNo = wBoolNo1 || wBoolNo2 || wBoolNo3;\n\nwBoolYes1 = wFAM_Undeground == \"Да\";\nwBoolYes2 = wFAM_Undeground == \"Yes\";\nwBoolYes3 = wFAM_Undeground == text_FAM_UndergroundDOWN;\nwBoolYes = wBoolYes1 || wBoolYes2 || wBoolYes3;\n\nwBoolWrong = !wBoolNo && !wBoolYes;\n\nwallsAZ3 = List.Clean(wBoolNo?walls:null, false);\nwallsBZ3 = List.Clean(wBoolYes?walls:null, false);\nwallsWrong = List.Clean(wBoolWrong?walls:null, false);",
