  "Nodes": [
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "bool1 = elements.GetCategory.Name == Category.ByName(\"OST_Walls\").Name;\nbool2 = elements.GetCategory.Name == Category.ByName(\"OST_Floors\").Name;\nbool3 = elements.GetCategory.Name == Category.ByName(\"OST_StructuralFraming\").Name;\nbool4 = elements.GetCategory.Name == Category.ByName(\"OST_StructuralColumns\").Name;\nbool5 = elements.GetCategory.Name == Category.ByName(\"OST_GenericModel\").Name;\nbool6 = elements.GetCategory.Name == Category.ByName(\"OST_EdgeSlab\").Name;\nbool7 = elements.GetCategory.Name == Category.ByName(\"OST_StructuralFoundation\").Name;\n\nwalls = List.FilterByBoolMask(elements, bool1)[\"in\"];\nfloors = List.FilterByBoolMask(elements, bool2)[\"in\"];\nstructuralFraming = List.FilterByBoolMask(elements, bool3)[\"in\"];\nstructuralColumns = List.FilterByBoolMask(elements, bool4)[\"in\"];\ngenericModel = List.FilterByBoolMask(elements, bool5)[\"in\"];\nedgeSlab = List.FilterByBoolMask(elements, bool6)[\"in\"];\nstructuralFoundation = List.FilterByBoolMask(elements, bool7)[\"in\"];",
      "Id": "52a56cb9f12c46b79bab535dc6144bb9",
