    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "zeroLowLevel;\nzeroHighLevel;\nBL;\nTL;\nBLO;\nTLO;\nUH;\nLVL;\nLO;\nfloors;\nzeroLowLevelElev;\nzeroHighLevelElev;\nfloorsLevel = Element.GetParameterValueByName(floors, LVL);\nfloorsLevelOffset = Element.GetParameterValueByName(floors, LO);\nfloorsLevelElevation = Math.Round(Level.Elevation(floorsLevel)+floorsLevelOffset);\nbool1 = floorsLevelElevation<=zeroHighLevelElev;\nbool2 = floorsLevelElevation>=zeroLowLevelElev;\nfilter1 = List.FilterByBoolMask(floors, bool1 && bool2);\nfilter2 = List.FilterByBoolMask(floorsLevelElevation, bool1 && bool2);\n\nzeroLevelFloorsElevation = Dictionary.ValueAtKey(filter2, \"in\");\nzeroLevelFloors = Dictionary.ValueAtKey(filter1, \"in\");",
      "Id": "7c98b4d37f034105a093429a242da2d1",
