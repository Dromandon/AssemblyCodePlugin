    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "zeroLowLevelElev;\nzeroHighLevelElev;\ncolumns;\nBL;\nTL;\nBLO;\nTLO;\n\ncolumnsTopLevel = Element.GetParameterValueByName(columns, TL);\ncolumnsTopLevelOffset = Element.GetParameterValueByName(columns, TLO);\ncolumnsBaseLevel = Element.GetParameterValueByName(columns, BL);\ncolumnsBaseLevelOffset = Element.GetParameterValueByName(columns, BLO);\n\n\ncolumnsTopLevelElev = Math.Round(columnsTopLevel.Elevation + columnsTopLevelOffset);\ncolumnsBaseLevelElev = Math.Round(columnsBaseLevel.Elevation + columnsBaseLevelOffset);\n\nbool1 = columnsBaseLevelElev>=zeroHighLevelElev;\nbool2 = columnsTopLevelElev<=zeroLowLevelElev;\nfilter1 = List.FilterByBoolMask(columns, bool1);\nfilter2 = List.FilterByBoolMask(columns, bool2);\n\n\n\nbool3 = columnsBaseLevelElev<zeroHighLevelElev;\nbool4 = columnsTopLevelElev>zeroLowLevelElev;\nfilter3 = List.FilterByBoolMask(columns, bool3 && bool4);\nfilter4 = List.FilterByBoolMask(columnsBaseLevelElev, bool3 && bool4);\nfilter5 = List.FilterByBoolMask(columnsTopLevelElev, bool3 && bool4);\ncolumnsBaseLevelElevToInspect = Dictionary.ValueAtKey(filter4, \"in\");\ncolumnsTopLevelElevToInspect = Dictionary.ValueAtKey(filter5, \"in\");\ncolumnsToInspectForSplit = Dictionary.ValueAtKey(filter3, \"in\");\n\ncolumnsAboveZero = Dictionary.ValueAtKey(filter1, \"in\");\ncolumnssBelowZero = Dictionary.ValueAtKey(filter2, \"in\");",
