      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "zeroHighLevelElev;\nbeams;\nRL = Apex.ParameterName(\"TRUSS_ELEMENT_REFERENCE_LEVEL_PARAM\");\nELO = Apex.ParameterName(\"TRUSS_ELEMENT_END1_ELEVATION\");\nSLO = Apex.ParameterName(\"TRUSS_ELEMENT_END0_ELEVATION\");\nZOV = Apex.ParameterName(\"Z_OFFSET_VALUE\");\nbeamLevel = Element.GetParameterValueByName(beams, RL);\nbeamELO = Element.GetParameterValueByName(beams, ELO);\nbeamSLO = Element.GetParameterValueByName(beams, SLO);\nbeamZOV = Element.GetParameterValueByName(beams, ZOV);\nbeamElevation = Math.Round(beamLevel.Elevation + (beamELO+beamSLO)/2+beamZOV);\nbool1 = beamElevation>zeroHighLevelElev;\nfilter1 = List.FilterByBoolMask(beams, bool1);\nbeamsAboveZero = Dictionary.ValueAtKey(filter1, \"in\");\nbeamsBelowZero = Dictionary.ValueAtKey(filter1, \"out\");",
