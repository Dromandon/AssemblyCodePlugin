    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "zeroLowLevel;\nzeroLowLevelOff;\nzeroHighLevel;\nzeroHighLevelOff;\nBL;\nTL;\nBLO;\nTLO;\nUH;\nLVL;\nLO;\nwalls;\nfloors;\n\nzeroLowLevelElev = Math.Round(Level.Elevation(zeroLowLevel)+zeroLowLevelOff);\nzeroHighLevelElev = Math.Round(Level.Elevation(zeroHighLevel)+zeroHighLevelOff);\n\nwallsTopLevel = Element.GetParameterValueByName(walls, TL);\nwallsTopLevelOffset = Element.GetParameterValueByName(walls, TLO);\nwallsBaseLevel = Element.GetParameterValueByName(walls, BL);\nwallsBaseLevelOffset = Element.GetParameterValueByName(walls, BLO);\nwallsUnconnectedHeight = Element.GetParameterValueByName(walls, UH);\n\nTLBool = DSCore.Object.Type(wallsTopLevel)==\"System.String\";\nwallsTopLevelElev = TLBool? Math.Round(wallsBaseLevel.Elevation + wallsUnconnectedHeight) : Math.Round(wallsTopLevel.Elevation + wallsTopLevelOffset);\n\nwallsBaseLevelElev = Math.Round(wallsBaseLevel.Elevation + wallsBaseLevelOffset);\n\nbool1 = wallsBaseLevelElev>=zeroHighLevelElev;\nbool2 = wallsTopLevelElev<=zeroLowLevelElev;\nfilter1 = List.FilterByBoolMask(walls, bool1);\nfilter2 = List.FilterByBoolMask(walls, bool2);\n\nbool3 = wallsBaseLevelElev<zeroHighLevelElev;\nbool4 = wallsTopLevelElev>zeroLowLevelElev;\nfilter3 = List.FilterByBoolMask(walls, bool3 && bool4);\nfilter4 = List.FilterByBoolMask(wallsBaseLevelElev, bool3 && bool4);\nfilter5 = List.FilterByBoolMask(wallsTopLevelElev, bool3 && bool4);\nwallsBaseLevelElevToInspect = Dictionary.ValueAtKey(filter4, \"in\");\nwallsTopLevelElevToInspect = Dictionary.ValueAtKey(filter5, \"in\");\nwallsToInspectForSplit = Dictionary.ValueAtKey(filter3, \"in\");\nwallsAboveZero = Dictionary.ValueAtKey(filter1, \"in\");\nwallsBelowZero = Dictionary.ValueAtKey(filter2, \"in\");",
      "Id": "a1b476f8344b43b8a471e80e790666cf",
