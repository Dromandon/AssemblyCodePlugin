    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "zeroLevelFloorsElevation;\nfPlane;\nstairsAboveZero1;\nstairsToInspect;\n\nstairsCuboid = BoundingBox.ToCuboid(Element.BoundingBox(stairsToInspect));\nsort = List.SortByKey(fPlane, zeroLevelFloorsElevation);\nsortedPlanes = Dictionary.ValueAtKey(sort, \"sortedList\");\nfPlaneHighest = List.Reverse(sortedPlanes)[0];\n\nsplitedGeoms = Geometry.Split(stairsCuboid, fPlaneHighest);\nbool1 = List.Count(splitedGeoms@L2<1>)>1;\nfilter1 = List.FilterByBoolMask(stairsToInspect, bool1);\nfilter2 = List.FilterByBoolMask(splitedGeoms, bool1);\nstairsToInspectFurther = Dictionary.ValueAtKey(filter1 , \"in\");\nstairsToInspectSplitedGeoms = Dictionary.ValueAtKey(filter2 , \"in\");\nstairsBelowZero1 = Dictionary.ValueAtKey(filter1, \"out\");\n\nzCuboid = Point.Z(Solid.Centroid(stairsToInspectSplitedGeoms));\nsorting = List.SortByKey(stairsToInspectSplitedGeoms@L2<1>, zCuboid@L2<1>);\nsortedByZGeoms = List.Transpose(Dictionary.ValueAtKey(sorting, \"sortedList\"));\nbool2 = sortedByZGeoms[0]==null?false:Solid.Volume(sortedByZGeoms[0])<=Solid.Volume(sortedByZGeoms[1]);\nfilter3 = List.FilterByBoolMask(stairsToInspectFurther, bool2);\nstairsAboveZero2 = Dictionary.ValueAtKey(filter3, \"in\");\nstairsBelowZero2 = Dictionary.ValueAtKey(filter3, \"out\");\n\n\nstairsAndLandingsAboveZero = List.Join([stairsAboveZero1, stairsAboveZero2]);\nstairsAndLandingsBelowZero = List.Join([stairsBelowZero1, stairsBelowZero2]);",
      "Id": "dedcc01ec6db453daa6608347db57980",
      "Inputs": [
