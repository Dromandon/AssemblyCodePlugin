    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\nkeys = IN[0]\r\nvalues = IN[1]\r\nwordsList = IN[2]\r\nmyKeys = []\r\nmyValues = []\r\nk=0\r\nfor words in wordsList:\r\n\tboolNoKey = True\r\n\tmyKeysTemp = []\r\n\tmyValuesTemp = []\r\n\tfor i in xrange(len(values)):\r\n\t\tbool1 = any([w.ToLower() in values[i].ToLower() for w in words[0]])\r\n\t\tif len(words[0])<1:\r\n\t\t\tbool1=True\r\n\t\tbool2 = all([w.ToLower() in values[i].ToLower() for w in words[1]])\r\n\t\tif len(words[1])<1:\r\n\t\t\tbool2=True\r\n\t\tbool3 = any([w.ToLower() in values[i].ToLower() for w in words[2]])\r\n\t\tif len(words[2])<1:\r\n\t\t\tbool3=False\r\n\t\tif bool1 and bool2 and not bool3:\r\n\t\t\tmyKeysTemp.append(keys[i])\r\n\t\t\tmyValuesTemp.append(values[i])\r\n\t\t\tboolNoKey = False\r\n\tif boolNoKey:\r\n\t\tk=k+1\r\n\t\tmyKeysTemp.append(\"No Key \"+str(k))\r\n\t\tmyValuesTemp.append(\"No Value \"+str(k))\r\n\tmyKeys.append(myKeysTemp)\r\n\tmyValues.append(myValuesTemp)\r\n# Place your code below this line\r\n\r\n# Assign your output to the OUT variable.\r\nOUT = [myKeys, myValues]",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "560f5b3bd95c43c3adeb76ce363e73ed",
      "Inputs": [
        {
          "Id": "bd9895f608d341d99bcee83a6fcb769c",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
