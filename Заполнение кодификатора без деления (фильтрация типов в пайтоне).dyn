    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import clr\r\n\r\n# 1. Revit API\r\nclr.AddReference(\"RevitAPI\")  \r\nfrom Autodesk.Revit.DB import *  \r\n\r\n# 2. Revit Services (для работы с документом)\r\nclr.AddReference(\"RevitServices\")  \r\nfrom RevitServices.Persistence import DocumentManager  \r\nfrom RevitServices.Transactions import TransactionManager  \r\n\r\n# 3. Dynamo Core (для работы с элементами Dynamo)\r\nclr.AddReference(\"DSCoreNodes\")  \r\nimport DSCore  \r\n\r\n# 4. Dynamo Revit (для операций, специфичных для Revit)\r\nclr.AddReference(\"RevitNodes\")  \r\nimport Revit  \r\n\r\n# 5. Преобразование Dynamo ↔ Revit (обязательно!)\r\nclr.ImportExtensions(Revit.Elements)  \r\nclr.ImportExtensions(Revit.GeometryConversion)  \r\n\r\ndef Warning(warnings, text):\r\n\t\r\n\twar = \"Не найдено описание подходящие для \"+text+\" в заданном классификаторе.\"\r\n\tif war not in warnings:\r\n\t\twarnings.append(war)\r\n# Получаем текущий документ Revit\r\ndoc = DocumentManager.Instance.CurrentDBDocument  \r\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument  \r\n\r\nelements = IN[0]\r\ntext_FAM_Undeground = IN[1]\r\nparamType = IN[2]\r\n#Assembly code для Walls\r\nparamAssCode = IN[3]\r\nassemblyCode_P = IN[4] #Пилоны\r\n\r\nassemblyCode_W = IN[6] #Стены\r\nassemblyCode_CSH = IN[7] #Стены лифтовых шахт\r\n#Assembly code для Walls и Structural Framings\r\nassemblyCode_Beams = IN[8] #Балки\r\n#Assembly code для Floors\r\nassemblyCode_F = IN[9] #Плиты\r\nassemblyCode_C = IN[10] #Капители\r\nassemblyCode_R = IN[17] #Рампы\r\nassemblyCode_EJF = IN[18] #Плиты вставки деформационных швов \r\n#Assembly code для Floors и Structural Foundation и Slab Edge\r\nassemblyCode_S = IN[11] #Фундаменты\r\n#Assembly code для Floors и Generic Models\r\nassemblyCode_LA = IN[12] #Лестничные площадки\r\n#Assembly code для Generic Models\r\nassemblyCode_STA = IN[13] #Лестничные марши\r\nassemblyCode_Heat = IN[14] #Термовкладыши\r\n#Assembly code для Structural Columns\r\nassemblyCode_SCO = IN[15] #Колонны\r\nassemblyCode_PILE = IN[16] #Сваи\r\n#Assembly code для Generic Models\r\n\r\n\r\nnewTypes = []\r\noldTypes = []\r\nwarnings = []\r\nwrongTypes = []\r\nfor elem in elements:\r\n\tboolTypeAssCode = True\r\n\tboolTypeUndeground = True\r\n\ttry:\r\n\t\telem.SetParameterByName(\"FAM_Underground\", text_FAM_Undeground)\r\n\t\tboolTypeUndeground = False\r\n\texcept: 1\r\n\ttry:\r\n\t\telem.SetParameterByName(paramAssCode, \"Нет такого типа\")\r\n\t\tboolTypeAssCode = False\r\n\texcept: 1\r\n\t\r\n\ttype = elem.GetParameterValueByName(paramType)\r\n\tcategoryName = elem.GetCategory.Name\r\n\toldTypes.append(type.Name)\r\n\r\n\tboolBeam = False\r\n\tboolSlab = \"Foundations\" in categoryName  or \"Slab\" in categoryName\r\n\r\n\tboolLanding = False\r\n\tboolSTA = False\r\n\tboolSCO = False\r\n\tboolPILE = False\r\n\tboolHEAT = False\r\n\t\r\n\tif hasattr(type, 'Family'):\r\n\t\tboolBeam = \"S_FRA_\" in str(type.Family) and not \"S_FRA_STE\" in str(type.Family)\r\n\t\tboolSlab = \"_Pit_\" in str(type.Family)\r\n\t\tboolLanding = \"Landing\" in str(type.Family)\r\n\t\tboolSCO = \"S_SCO_RCO_Column\" in str(type.Family) or \"S_SCO_Column\" in str(type.Family)\r\n\t\tboolPILE = \"S_SCO_RCO_Pile\"in str(type.Family) or \"S_SCO_Pile\"in str(type.Family)\r\n\t\tboolSTA = \"Stair\" in str(type.Family) and not boolLanding\r\n\t\tboolHEAT = \"_HeatInsulating\" in str(type.Family)\r\n\r\n\t\t\r\n\tboolNotRename = boolSlab or boolPILE\r\n\tnewName = \"\"\t\r\n\tnewType = elem\r\n\tif boolTypeAssCode:\r\n\t\tif not type.Name.endswith(\"_BGL\") and not boolNotRename:\r\n\t\t\tnewName = type.Name +\"_BGL\"\t\t\r\n\t\t\ttry:\r\n\t\t\t\tnewType = type.Duplicate(newName)\r\n\t\t\texcept:\r\n\t\t\t\ttry:\r\n\t\t\t\t\tnewType = type.ByName(newName)\r\n\t\t\t\texcept:\r\n\t\t\t\t\tnewType = type.ByFamilyAndName(type.Family, newName)\r\n\t\telse:\r\n\t\t\tnewType = type\r\n\t\telem.SetParameterByName(paramType, newType)\r\n\t\t\t\r\n\tif newType.Name not in newTypes or newType == elem:\r\n\t\ttry:\r\n\t\t\tnewType.SetParameterByName(\"FAM_Underground\", text_FAM_Undeground)\r\n\t\texcept:\r\n\t\t\telem.SetParameterByName(\"FAM_Underground\", text_FAM_Undeground)\t\r\n\t\t\r\n\t\tif \"_P_\" in newType.Name:\r\n\t\t\ttry: newType.SetParameterByName(paramAssCode,assemblyCode_P)\r\n\t\t\texcept: Warning(warnings, \"пилонов подземной части\")\r\n\t\telif \"_W_\" in newType.Name:\r\n\t\t\ttry: newType.SetParameterByName(paramAssCode,assemblyCode_W)\r\n\t\t\texcept: Warning(warnings, \"стен подземной части\")\r\n\t\telif \"_B_\" in newType.Name or boolBeam:\r\n\t\t\ttry: newType.SetParameterByName(paramAssCode,assemblyCode_Beams)\r\n\t\t\texcept: Warning(warnings, \"балок подземной части\")\r\n\t\telif \"_CSH_\" in newType.Name:\r\n\t\t\ttry: newType.SetParameterByName(paramAssCode,assemblyCode_CSH)\r\n\t\t\texcept: Warning(warnings, \"стен лифтовых шахт подземной части\")\r\n\t\t\t\t\r\n\t\telif \"_F_\" in newType.Name:\r\n\t\t\ttry: newType.SetParameterByName(paramAssCode,assemblyCode_F)\r\n\t\t\texcept: Warning(warnings, \"плит перекрытий подземной части\")\r\n\t\telif \"_C_\" in newType.Name:\r\n\t\t\ttry: newType.SetParameterByName(paramAssCode,assemblyCode_C)\r\n\t\t\texcept: Warning(warnings, \"капителей подземной части\")\r\n\t\telif \"_R_\" in newType.Name:\r\n\t\t\ttry: newType.SetParameterByName(paramAssCode,assemblyCode_R)\r\n\t\t\texcept: Warning(warnings, \"рамп подземной части\")\r\n\t\telif \"_EJF_\" in newType.Name:\r\n\t\t\ttry: newType.SetParameterByName(paramAssCode,assemblyCode_EJF)\r\n\t\t\texcept: Warning(warnings, \"плит вставок деформационных швов подземной части\")\r\n\t\telif \"_S_\" in newType.Name or boolSlab:\r\n\t\t\ttry: newType.SetParameterByName(paramAssCode,assemblyCode_S)\r\n\t\t\texcept: Warning(warnings, \"фундаментных плит\")\r\n\t\telif \"_LA_\" in newType.Name or boolLanding:\r\n\t\t\ttry: newType.SetParameterByName(paramAssCode,assemblyCode_LA)\r\n\t\t\texcept: Warning(warnings, \"лестничных площадок из монолитного жб подземмной части\")\r\n\t\t\t\t\r\n\t\telif boolSTA:\r\n\t\t\ttry: newType.SetParameterByName(paramAssCode,assemblyCode_STA)\r\n\t\t\texcept: Warning(warnings, \"лестниц из монолитного жб подземной части\")\r\n\t\telif boolHEAT:\r\n\t\t\ttry: newType.SetParameterByName(paramAssCode,assemblyCode_HEAT)\r\n\t\t\texcept: Warning(warnings, \"термовкладышей подземной части\")\r\n\t\t\t\t\r\n\t\telif boolSCO:\r\n\t\t\ttry: newType.SetParameterByName(paramAssCode,assemblyCode_SCO)\r\n\t\t\texcept: Warning(warnings, \"колонн подземной части\")\r\n\r\n\t\telif boolPILE:\r\n\t\t\ttry: newType.SetParameterByName(paramAssCode,assemblyCode_PILE)\r\n\t\t\texcept: Warning(warnings, \"свай\")\t\r\n\t\t\t\r\n\t\telse:\r\n\t\t\twrongTypes.append(newType)\r\n \r\n\tnewTypes.append(newType.Name)\r\nOUT = [warnings, elements, wrongTypes]",
