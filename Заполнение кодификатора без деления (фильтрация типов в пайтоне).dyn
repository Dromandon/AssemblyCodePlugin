      "Code": "genericModel;\nbool1 = str != \"ModelText\";\nfilter1 = List.FilterByBoolMask(genericModel, bool1);\ngenericFamilies = Dictionary.ValueAtKey(filter1, \"in\");\ngenericFamiliesNames = Family.Name(FamilyInstance.GetFamily(genericFamilies));\nbool2 = String.Contains(genericFamiliesNames, \"Stair\", false);\nfilter2 = List.FilterByBoolMask(genericFamilies , bool2);\nstairs = Dictionary.ValueAtKey(filter2, \"in\");\n\nbool3 = String.Contains(genericFamiliesNames, \"_HeatInsulating\", false);\nfilter3 = List.FilterByBoolMask(genericFamilies , bool3);\nheatInsulating = Dictionary.ValueAtKey(filter3, \"in\");",
