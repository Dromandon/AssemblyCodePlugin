    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\nkeys = IN[0]\r\nvalues = IN[1]\r\nmyValues = IN[2]\r\nmyKeys =[]\r\nmyValuesNew = []\r\nbelowZero = [\"подзем\", \"ниже\"]\r\nfor myValue in myValues:\r\n\tbool1=True\r\n\tupperKey=\"\"\r\n\tif len(myValue)<2:\r\n\t\tfor i in xrange(len(values)):\r\n\t\t\tif myValue[0] == values[i]:\r\n\t\t\t\tmyKeys.append(keys[i])\r\n\t\t\t\tmyValuesNew.append(values[i])\r\n\t\t\t\tbool1=False\r\n\telse:\r\n\r\n\t\tfor mv in myValue:\r\n\t\t\tboolIn = False\r\n\t\t\tfor i in xrange(len(values)):\r\n\t\t\t\tif mv == values[i]:\r\n\t\t\t\t\tendIndex = keys[i].rfind(\".\")\r\n\t\t\t\t\tupperKey=keys[i][0:endIndex]\r\n\t\t\t\t\tfor j in xrange(len(keys)):\r\n\t\t\t\t\t\tif upperKey==keys[j]:\r\n\t\t\t\t\t\t\tif any([bz.ToLower() in values[j].ToLower() for bz in belowZero]):\r\n\t\t\t\t\t\t\t\tmyKeys.append(keys[i])\r\n\t\t\t\t\t\t\t\tmyValuesNew.append(values[i])\r\n\t\t\t\t\t\t\t\tboolIn=True\r\n\t\t\t\t\t\t\t\tbool1=False\r\n\t\t\tif boolIn:\r\n\t\t\t\tbreak\r\n\tif bool1:\r\n\t\tmyKeys.append(\"No Code\")\r\n\t\tmyValuesNew.append(\"No Code\")\r\n\t\t\r\n\t\r\n# Place your code below this line\r\n\r\n# Assign your output to the OUT variable.\r\nOUT = [myKeys,myValuesNew]",
