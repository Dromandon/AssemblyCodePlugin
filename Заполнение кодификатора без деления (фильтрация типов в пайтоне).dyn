    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "floorSurface;\ncolTIFS;\ncolBL;\ncolTL;\n\n//Фильтрую стены, которые пересекают больше двух плит или не пересекают их.\nwallGeo = BoundingBox.ToCuboid(Element.BoundingBox(colTIFS));\nbool1 = Geometry.DoesIntersect(floorSurface<2>, wallGeo<1>);\nbool2 = List.CountTrue(bool1@L2<1>) != 1;\nfilterCol1 = List.FilterByBoolMask(colTIFS, bool2);\nfilterBL1 = List.FilterByBoolMask(colBL, bool2);\nfilterTL1 = List.FilterByBoolMask(colBL, bool2);\ncolToInspectFurther = Dictionary.ValueAtKey(filterCol1, \"in\");\ncolToInspectFurtherBL = Dictionary.ValueAtKey(filterBL1, \"in\");\ncolToInspectFurtherTL = Dictionary.ValueAtKey(filterTL1, \"in\");\ncolToInspect = Dictionary.ValueAtKey(filterCol1, \"out\");\n\nbool0 = List.CountTrue(bool1@L2<1>) == 0;\nboolGreater1 = List.CountTrue(bool1@L2<1>) > 1;\nfilterCol0 = List.FilterByBoolMask(colTIFS, bool0);\nfilterColBL0 = List.FilterByBoolMask(colBL, bool0);\nfilterColTL0 = List.FilterByBoolMask(colTL, bool0);\ncolIntercested0 = Dictionary.ValueAtKey(filterCol0, \"in\");\n\nfilterColGreater1 = List.FilterByBoolMask(colTIFS, boolGreater1);\nfilterColBLGreater1 = List.FilterByBoolMask(colBL, boolGreater1);\nfilterColTLGreater1 = List.FilterByBoolMask(colTL, boolGreater1);\n\ncolIntercestedGreater1 = Dictionary.ValueAtKey(filterColGreater1, \"in\");\ncolBLGreater1 = Dictionary.ValueAtKey(filterColBLGreater1, \"in\");\ncolTLGreater1 = Dictionary.ValueAtKey(filterColTLGreater1, \"in\");\n\n//Определю, является пересечение стены пересечением или только косанием.\n//Если косание, то определеяю с какой стороны (верх или низ)\n//В зависимости от места соприкосновения определяю выше или ниже нуля стена\ncolToInspectGeo = BoundingBox.ToCuboid(Element.BoundingBox(colToInspect));\npMin = BoundingBox.MinPoint(Element.BoundingBox(colToInspect));\npMax = BoundingBox.MaxPoint(Element.BoundingBox(colToInspect));\nintersectionGeo = Geometry.Intersect(floorSurface<2>, colToInspectGeo<1>);\nintersectionGeoClean = List.Clean(intersectionGeo@L1<1>, true);\npoint1 = Surface.PointAtParameter(intersectionGeoClean, 0.5, 0.5)==null?Curve.PointAtParameter(intersectionGeoClean, 0.5):Surface.PointAtParameter(intersectionGeoClean, 0.5, 0.5);\n//point1 = Surface.PointAtParameter(intersectionGeoClean, 0.5, 0.5);\nplane1 = Plane.ByOriginNormal(point1, Vector.ZAxis());\nboolBB = List.Flatten(BoundingBox.Contains(Element.BoundingBox(colToInspect), point1),-1);\nbool3 = List.Flatten(boolBB && Geometry.DistanceTo(pMin, plane1)<1,-1);\nbool4 = List.Flatten(boolBB && Geometry.DistanceTo(pMax, plane1)<1,-1);\n\n//filter 2 - если стена не подходит к данному условию, то её надо рассечь\n//filter 3 и 4 - определяю выше или ниже нуля стена\nfilter2 = List.FilterByBoolMask(colToInspect, (bool3 || bool4));\nfilter3 = List.FilterByBoolMask(colToInspect, bool3);\nfilter4 = List.FilterByBoolMask(colToInspect, bool4);\n\ncolToSplit = Dictionary.ValueAtKey(filter2, \"out\");\ncolToWarning = List.Flatten([colToSplit,colIntercested0], -1);\ncolAboveZero2 = Dictionary.ValueAtKey(filter3, \"in\");\ncolBelowZero2 = Dictionary.ValueAtKey(filter4, \"in\");",
      "Id": "7cfbae44e76d43c6815c59bef621c102",
      "Inputs": [
        {
          "Id": "f162d54e5d6e42a186f4cfd32cc5ce14",
          "Name": "floorSurface",
          "Description": "floorSurface",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "4c8d8d72952e415c9aa9762277eb863a",
          "Name": "colTIFS",
          "Description": "colTIFS",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d07b632f36eb4f7ab6fcbea29a1c0bb1",
          "Name": "colBL",
          "Description": "colBL",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1c4a42d9219848ababc74f9eab01882d",
          "Name": "colTL",
          "Description": "colTL",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "0b3576d14eeb49929928239082b93dcc",
