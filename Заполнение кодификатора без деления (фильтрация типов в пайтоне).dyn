      "Code": "exceptionWords = [\"Подзем\", \"Демонтаж\", \"штроб\", \"архитект\",\n\"пробив\", \"анкер\", \"крышк\", \"арх\", \"помещ\", \"отдел\", \"срубка\"];\n//[[1],[2],[3]]\n//anyTrue - хотя бы 1 из списка должно быть в имени\n//allTrue - всё из списка обязательно должно быть в имени\n//exceptions - ничего из списка не должно быть в имени\n//extraTrue - {\"Слово\":\"Приоритет\"} - дополнительный приоритет, если есть\n//указанные слова. Приоритет слова указывается через двоеточие. Если есть\n//несколько слов, то их приоритеты складываются.\n//-----------------\n//4 Пилоны;\n{\"anyTrue\":[],\n\"allTrue\":[\"пилон\"],\n\"exceptions\": List.Flatten([exceptionWords],-1),\n\"extraTrue\":[{\"монолит\":1}]};\n\n//5 Парапеты;\n{\"anyTrue\":[],\n\"allTrue\":[\"парапет\"],\n\"exceptions\": List.Flatten([exceptionWords],-1),\n\"extraTrue\":[{\"монолит\":1}]};\n\n//6 Стены;\n{\"anyTrue\":[],\n\"allTrue\":[\"стен\"],\n\"exceptions\": List.Flatten([exceptionWords],-1),\n\"extraTrue\":[{\"монолит\":1}]};\n\n//7 Стены лифтовых шахт;\n{\"anyTrue\":[\"стен\",\"лифт\"],\n\"allTrue\":[],\n\"exceptions\": List.Flatten([exceptionWords, \"сбор\"],-1),\n\"extraTrue\":[{\"лифтовых шахт из монолитного\":10},\n{\"лифтовая шахта из монолитного\":10},\n{\"монолит\":1},{\"стен\":1}]};\n\n//8 Балки;\n{\"anyTrue\":[\"балки\", \"балок\", \"балка\"],\n\"allTrue\":[],\n\"exceptions\": List.Flatten([exceptionWords],-1),\n\"extraTrue\":[{\"монолит\":1}]};\n\n//9 Плиты;\n{\"anyTrue\":[\"плит\", \"перекрыт\"],\n\"allTrue\":[],\n\"exceptions\": List.Flatten([exceptionWords,\"Фунд\",\"плит вставок деф\", \"шахт\"],-1),\n\"extraTrue\":[{\"монолит\":1}]};\n\n//10 Капители;\n{\"anyTrue\":[],\n\"allTrue\":[],\n\"exceptions\": List.Flatten([exceptionWords,\"Фунд\",\"плит вставок деф\"],-1),\n\"extraTrue\":[{\"Капитель\":5}, {\"плит\":1},{\"перекрыт\":1}, {\"монолит\":1}]};\n\n//11 Фундаменты;\n//[[], [\"Фунд\", \"плит\"], [\"Подзем\"]];\n\n//12 Лестничные площадки;\n{\"anyTrue\":[\"лест\",\"Лестнич\", \"плит\", \"перекрыт\"],\n\"allTrue\":[],\n\"exceptions\": List.Flatten([exceptionWords,\"Сбор\",\"Фунд\",\n\"плит вставок деф\", \"шахт\"],-1),\n\"extraTrue\":[{\"монолит\":1},{\"площад\":2}]};\n\n//13 Лестничные марши;\n{\"anyTrue\":[\"лестниц\", \"лестничных маршей\", \"Лестничный марш\", \"ЛМ\"],\n\"allTrue\":[],\n\"exceptions\": List.Flatten([exceptionWords,\"Сбор\", \"металл\", \"покрыт\"],-1),\n\"extraTrue\":[{\"монолит\":1}]};\n\n//14 Термовкладыши;\n{\"anyTrue\":[],\n\"allTrue\":[\"термовклад\"],\n\"exceptions\": List.Flatten([exceptionWords],-1),\n\"extraTrue\":[]};\n\n\n//15 Колонны;\n{\"anyTrue\":[],\n\"allTrue\":[\"Колон\"],\n\"exceptions\": List.Flatten([exceptionWords, \"Стал\", \"метал\"],-1),\n\"extraTrue\":[{\"монолит\":1}]};\n\n//16 Рампы;\n{\"anyTrue\":[],\n\"allTrue\":[\"рамп\"],\n\"exceptions\": List.Flatten([exceptionWords],-1),\n\"extraTrue\":[{\"монолит\":1}]};\n\n//17 Плиты вставки деформационных швов;\n{\"anyTrue\":[],\n\"allTrue\":[\"плит вставок деф\"],\n\"exceptions\": List.Flatten([exceptionWords],-1),\n\"extraTrue\":[{\"монолит\":1}]};",
      "Id": "9abf679a67ff4d379ec4dcdb948d6932",
