    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "cType = collumns.GetParameterValueByName(Apex.ParameterName(\"ELEM_TYPE_PARAM\"));\n\ncParameter1 = Element.GetParameterValueByName(collumns, \"FAM_Underground\");\ncParameter2 = Element.GetParameterValueByName(cType, \"FAM_Underground\");\ncFAM_Undeground = cParameter1 == \"\"? cParameter2: cParameter1;\n\ncBoolNo1 = cFAM_Undeground == \"Нет\";\ncBoolNo2 = cFAM_Undeground == \"No\";\ncBoolNo3 = cFAM_Undeground == text_FAM_UndergroundUP;\ncBoolNo = cBoolNo1 || cBoolNo2 || cBoolNo3;\n\ncBoolYes1 = cFAM_Undeground == \"Да\";\ncBoolYes2 = cFAM_Undeground == \"Yes\";\ncBoolYes3 = cFAM_Undeground == text_FAM_UndergroundDOWN;\ncBoolYes = cBoolYes1 || cBoolYes2 || cBoolYes3;\n\ncBoolWrong = !cBoolNo && !cBoolYes;\n\ncollumnsAZ3 = List.Clean(cBoolNo?collumns:null, false);\ncollumnsBZ3 = List.Clean(cBoolYes?collumns:null, false);\ncollumnsWrong = List.Clean(cBoolWrong?collumns:null, false);",
      "Id": "ab38747edd19405e88a10060d46967db",
