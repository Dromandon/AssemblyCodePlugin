    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "//4 Пилоны;\n\"Устройство пилонов подземной части из монолитного ж/б\";\n//5 Парапеты;\n\"Устройство монолитных ж/б парапетов\";\n//6 Стены;\n\"Устройство стен подземной части из монолитного ж/б\";\n//7 Стены лифтовых шахт;\n\"Устройство лифтовых шахт подземной части из монолитного ж/б\";\n//8 Балки;\n\"Устройство балок подземной части из монолитного ж/б\";\n//9 Плиты;\n\"Устройство плит перекрытия подземной части из монолитного ж/б\";\n//10 Капители;\n\"Устройство плит перекрытия подземной части из монолитного ж/б\";\n//11 Фундаменты;\n\"Устройство фундаментной плиты\";\n//12 Лестничные площадки;\n\"Устройство лестниц, площадок подземной части из монолитного ж/б\";\n//13 Лестничные марши;\n\"Устройство лестниц, площадок подземной части из монолитного ж/б\";\n//14 Термовкладыши;\n\"Устройство термовкладышей ж/б конструкций\";\n//15 Колонны;\n\"Устройство колонн подземной части из монолитного ж/б\";\n//16 Сваи;\n\"Устройство свайного основания\";\n//17 Рампы;\n\"Устройство рамп, пандусов подземной части из монолитного ж/б\";\n//18 Плиты вставки деформационных швов;\n\"Устройство плит вставок деформационных швов подземной части из монолитного ж/б\";",
