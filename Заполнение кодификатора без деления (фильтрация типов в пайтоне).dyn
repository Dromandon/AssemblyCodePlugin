    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "wallsTIFS;\n//Фильтрую стены, которые пересекают больше двух плит или не пересекают их.\nwallGeo = BoundingBox.ToCuboid(Element.BoundingBox(wallsTIFS));\nbool1 = Geometry.DoesIntersect(surfaces<2>, wallGeo<1>);\nbool2 = List.CountTrue(bool1@L2<1>) > 0;\nindex = List.AllIndicesOf(bool1@L2<1>, true);\nfloorSurfacesList = List.GetItemAtIndex(surfaces, index);\nz = Surface.PointAtParameter(floorSurfacesList, 0.5, 0.5).Z;\nboolTopMORE = wallsTL>List.MaximumItem(z);\nboolTopEQU = wallsTL==List.MaximumItem(z);\nboolTopLESSorEQU = wallsTL<=List.MaximumItem(z);\nboolBottomMORE = wallsBL>List.MinimumItem(z);\nboolBottomEQU = wallsBL==List.MinimumItem(z);\nboolBottomLESS = wallsBL<List.MinimumItem(z);\nboolAbove = boolTopMORE && boolBottomEQU;\nboolBelow = boolTopLESSorEQU;\nboolRepair = !boolAbove && !boolBelow;\nfilter1 = List.FilterByBoolMask(wallsTIFS, boolAbove);\nfilter2 = List.FilterByBoolMask(wallsTIFS, boolBelow);\nfilter3 = List.FilterByBoolMask(wallsTIFS, boolRepair);\n\nwallsAboveZero4 = Dictionary.ValueAtKey(filter1, \"in\");\nwallsBelowZero4 = Dictionary.ValueAtKey(filter2, \"in\");\nwallsToRepair = Dictionary.ValueAtKey(filter3, \"in\");",
      "Id": "1e522daad6d64cea883c3c6893cab043",
      "Inputs": [
