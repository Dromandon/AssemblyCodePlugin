      "Code": "AssCode;\ntypeBIN;\nelementCodeBZ;\nwrongTypeNames;\nwrongElements;\nrightT;\nuniqueWTN;\nnewT;\n\nindexes = List.AllIndicesOf(wrongTypeNames, uniqueWTN);\nelements = List.GetItemAtIndex(wrongElements, indexes);\nelementsNewRightNames = Element.SetParameterByName(elements, typeBIN, newT);\n\nallRightT=List.Join([rightT, newT]);\nsort = List.SortByKey(allRightT, WallType.Name(allRightT));\nsortedByNameT = List.UniqueItems(Dictionary.ValueAtKey(sort, \"sortedList\"));\n\nzero = List.IndexOf(sortedByNameT, sortedByNameT)>8?\"\":\"0\";\ntext = elementCodeBZ+\".\"+zero+(List.IndexOf(sortedByNameT,sortedByNameT)+1);\nElement.SetParameterByName(sortedByNameT, AssCode, text);",
