    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "notRepairedWalls=List.Flatten([notRepairedWalls1, wallsWrong],-1);\nnotRepairedColumns=List.Flatten([notRepairedCollumnss1, collumnsWrong],-1);\nidWalls=List.Flatten(notRepairedWalls.Id);\nidInGroups=List.Flatten(inGroups.Id);\nidLWalls=String.Join(\", \",ToString([null,idWalls][List.IsEmpty(idWalls)?0:1]<1>));\nidColumns=List.Flatten(notRepairedColumns.Id);\nidLColumns=String.Join(\", \",ToString([null,idColumns][List.IsEmpty(idColumns)?0:1]<1>));\nidInGroupsT=String.Join(\", \",ToString([null,idInGroups][List.IsEmpty(idInGroups)?0:1]<1>));\n\nwa1={\"Code\":\"0001\",\n\"Type\":\"Warning\",\n\"Status\":List.Count(notRepairedWalls)>0,\n\"Name\":\"Стена рассекается плитой нуля или не рассекается ни одной плитой в данном уровне.\",\n\"Solution\":\"Самостоятельно проверьте правильность наименование данных стен. ID стен:\n\"+idLWalls+\"\nДанные стены пересекают плиты на уровне разделения ниже и выше нуля, либо не пересекают ни одну из таких плит.\nЕсли после самостоятельной проверки у стен был верно заполнен параметр FAM_Underground, то запустите динамо заного, введя ID отработтаных стен в указанное поле ниже.\nЭлементы можно быстро найти воспользовавшись кнопкой Select by ID (Выбрать по коду) на вкладке Manage (Управление)\"};\n\nwa2={\"Code\":\"0002\",\n\"Type\":\"Warning\",\n\"Status\":List.Count(notRepairedColumns)>0,\n\"Name\":\"Колонна рассекается плитой нуля или не рассекается ни одной плитой в данном уровне.\",\n\"Solution\":\"Самостоятельно проверьте правильность наименование данных колонн. ID колонн:\n\"+idLColumns+\"\nДанные колонны пересекают плиты на уровне разделения ниже и выше нуля, либо не пересекают ни одну из таких плит.\nЕсли после самостоятельной проверки у колонн был верно заполнен параметр FAM_Underground, то запустите динамо заного, введя ID отработтаных колонн в указанное поле ниже.\nЭлементы можно быстро найти воспользовавшись кнопкой Select by ID (Выбрать по коду) на вкладке Manage (Управление)\"};\n\nwa3={\"Code\":\"0003\",\n\"Type\":\"Warning\",\n\"Status\":List.Count(AZCodes)>0,\n\"Name\":AZCodes,\n\"Solution\": \"Обратитесь к разработчику скрипта для решения проблемы.\"\n};\n\nwa4={\"Code\":\"0004\",\n\"Type\":\"Warning\",\n\"Status\":List.Count(BZCodes)>0,\n\"Name\":BZCodes,\n\"Solution\": \"Обратитесь к разработчику скрипта для решения проблемы.\"\n};\n\nwa5={\"Code\":\"0005\",\n\"Type\":\"Warning\",\n\"Status\":List.Count(inGroups)>0,\n\"Name\":\"Данные элементы находятся в группах, изменения их типразмеров или параметров приведёт к разгруппировки группы\",\n\"Solution\": \"Самостоятельно отредактируйте типоразмеры данных элементов:\n\"+idInGroupsT\n};\n\n[wa1, wa2, wa3, wa4, wa5];",
      "Id": "ee8cc9d77bf94a7db0c52652339b21cb",
      "Inputs": [
