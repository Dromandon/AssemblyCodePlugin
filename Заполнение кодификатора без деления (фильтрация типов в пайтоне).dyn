    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "columnsAboveZero3;\ncolumnsBelowZero3;\ncolumnsAboveZero2;\ncolumnsBelowZero2;\ncolumnsAboveZero1;\ncolumnsBelowZero1;\ncolumnsAboveZero4;\ncolumnsBelowZero4;\n\n\ncolumnsAboveZero = List.Join([columnsAboveZero1, columnsAboveZero2, columnsAboveZero3, columnsAboveZero4]);\ncolumnsAndPilesBelowZero = List.Join([columnsBelowZero1, columnsBelowZero2, columnsBelowZero3, columnsBelowZero4]);",
