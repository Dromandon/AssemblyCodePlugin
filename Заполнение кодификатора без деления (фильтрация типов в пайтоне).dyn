    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "wallsToRepair;\nwallsToSplit;\nwalls = List.Flatten([wallsToRepair, wallsToSplit],-1);\ncolumnsToRepair;\ncolumnsToSplit;\ncolumns = List.Flatten([columnsToRepair, columnsToSplit],-1);\nwallsElemIDs = Elements.Element.Id(walls);\ncolumnsElemIDs = Elements.Element.Id(columns);\nids = String.ToNumber(String.TrimWhitespace(IDS));\nwallsBool1 = wallsElemIDs<1> == ids<2>;\nwallsBool2 = List.AnyTrue(wallsBool1<1>);\nnotRepairedWalls = List.FilterByBoolMask(walls, wallsBool2)[\"out\"];\nrepairedWalls = List.FilterByBoolMask(walls, wallsBool2)[\"in\"];\ncolumnsBool1 = columnsElemIDs<1> == ids<2>;\ncolumnsBool2 = List.AnyTrue(columnsBool1<1>);\nnotRepairedColumns = List.FilterByBoolMask(columns, columnsBool2)[\"out\"];\nrepairedColumns = List.FilterByBoolMask(columns, columnsBool2)[\"in\"];",
      "Id": "728c83b774e5412f974343cb9bb74a0e",
