    {
      "ConcreteType": "Dynamo.Graph.Nodes.CodeBlockNodeModel, DynamoCore",
      "NodeType": "CodeBlockNode",
      "Code": "\"WALL_USER_HEIGHT_PARAM\";",
      "Id": "70c77c158f4f4593b47384c1291f4b62",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "42f073a2412b48ed9fa9593dca52af50",
