<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2022.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Update="AssemblyCodePlugin.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="PostBuildCopyToAddins" AfterTargets="PostBuildEvent">
    <MakeDir Directories="C:\ProgramData\Autodesk\Revit\Addins\2022" />
    <Copy SourceFiles="$(TargetDir)AssemblyCodePlugin.dll;$(TargetDir)AssemblyCodePlugin.addin"
          DestinationFolder="C:\ProgramData\Autodesk\Revit\Addins\2022"
          ContinueOnError="true" />
    <MakeDir Directories="$(AppData)\Autodesk\Revit\Addins\2022" />
    <Copy SourceFiles="$(TargetDir)AssemblyCodePlugin.dll;$(TargetDir)AssemblyCodePlugin.addin"
          DestinationFolder="$(AppData)\Autodesk\Revit\Addins\2022"
          ContinueOnError="true" />
    <MakeDir Directories="C:\Users\Dromandon\Desktop\Рабочие плагины\AssemblyCode\Готовый_Плагин_Revit2022" />
    <Copy SourceFiles="$(TargetDir)AssemblyCodePlugin.dll;$(TargetDir)AssemblyCodePlugin.addin"
          DestinationFolder="C:\Users\Dromandon\Desktop\Рабочие плагины\AssemblyCode\Готовый_Плагин_Revit2022"
          ContinueOnError="true" />
  </Target>

</Project>
