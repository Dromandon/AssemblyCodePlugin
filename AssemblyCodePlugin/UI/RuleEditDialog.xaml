<Window x:Class="AssemblyCodePlugin.UI.RuleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройка правила классификации" Height="640" Width="820"
        WindowStartupLocation="CenterOwner" Background="#F4F4F5" Foreground="#18181B"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="ApexRed"       Color="#E23E2E"/>
        <SolidColorBrush x:Key="ApexRedDark"   Color="#C0342A"/>
        <SolidColorBrush x:Key="BorderColor"   Color="#D4D4D8"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#71717A"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#18181B"/>
        <SolidColorBrush x:Key="SurfaceWhite"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ChipBg"        Color="#E4E4E7"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>

        <!-- Стиль визуального чипа (Tag Chip) -->
        <DataTemplate x:Key="ChipTemplate">
            <Border Background="{StaticResource ChipBg}" CornerRadius="12" Padding="10,4,6,4" Margin="0,0,6,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Content="✕" Width="18" Height="18" FontSize="10" FontWeight="Bold"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Foreground="{StaticResource TextSecondary}"
                            Tag="{Binding}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Стиль вкладок -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" BorderThickness="0,0,0,2" Margin="0,0,12,0" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource ApexRed}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ApexRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ApexRed}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ApexRedDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E4E4E7"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ApexRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="{StaticResource ApexRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Сам тумблер (Пилюля 38x22) -->
                            <Grid Width="38" Height="22" Margin="0,0,10,0">
                                <Border x:Name="Track" CornerRadius="11" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.2"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <!-- Подпись рядом -->
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0EA5E9"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#0284C7"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Шапка: Основное название правила -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceWhite}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Название правила:" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Column="1" x:Name="TxtTypeName" Height="32" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- 2. Вкладки с интерактивными Чипами и Таблицей баллов -->
        <TabControl Grid.Row="1">

            <!-- ═══ ВКЛАДКА 1: Фильтрация элементов ════════════════════════ -->
            <TabItem Header="Фильтрация элементов">
                <Border Background="{StaticResource SurfaceWhite}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,6,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Категория -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Категория Revit:" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="CmbCategory" Height="32" 
                                          SelectionChanged="CmbCategory_SelectionChanged"
                                          TextBoxBase.TextChanged="CmbCategory_TextChanged"
                                          ItemsSource="{Binding Categories}"
                                          DisplayMemberPath="Display"
                                          SelectedValuePath="BIC"
                                          IsEditable="True"
                                          IsTextSearchEnabled="False" />
                            </Grid>

                            <!-- Дерево условий отбора элементов -->
                            <Border Grid.Row="2" Grid.RowSpan="5" Background="{StaticResource SurfaceWhite}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Условия отбора элементов (можно использовать вложенные группы И / ИЛИ):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <!-- Сюда в Code-Behind будет динамически добавлен корневой FilterNodeControl -->
                                        <ContentControl x:Name="RootFilterContainer" Margin="0,0,12,0" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- Настройка автоматического добавления суффикса к имени типа -->
                            <Border Grid.Row="8" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Orientation="Vertical">
                                    <CheckBox x:Name="ChkAppendTypeSuffix" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Click="ChkAppendTypeSuffix_Click">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Добавлять суффикс к имени типа при классификации (создание отдельного типа при необходимости)" FontWeight="SemiBold" Foreground="#1E293B"/>
                                            <TextBlock Text="* Применяется только если системный параметр классификатора является параметром типа" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <Grid x:Name="PanelTypeSuffix" Margin="48,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Суффикс типа:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#334155" Margin="0,0,10,0"/>
                                        <TextBox Grid.Column="1" x:Name="TxtTypeSuffix" Height="28" VerticalContentAlignment="Center" ToolTip="Например: _L01 или _Тип2 (если в имени типа его нет, плагин добавит и создаст дубликат типа)"/>
                                        <TextBlock Grid.Column="2" Text="* Позволяет разделять элементы одной категории с разными параметрами экземпляра на разные типы" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Margin="12,0,0,0" TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ═══ ВКЛАДКА 2: Код для надземной части ══════════════════════ -->
            <TabItem Header="Код для надземной части">
                <Border Background="{StaticResource SurfaceWhite}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,6,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,12,0">
                            <!-- Кнопки копирования и справки над всеми настройками вкладки -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,14">
                                <Button x:Name="BtnCopyAboveToBelow"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="32"
                                        Padding="10,0"
                                        Click="BtnCopyAboveToBelow_Click"
                                        ToolTip="Скопировать все списки ключевых слов (AnyTrue, AllTrue, Исключения) и таблицу баллов из этой вкладки во вкладку «Код для подземной части»">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📋" FontFamily="Segoe UI Emoji" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="→ Подземная часть" FontSize="12" FontWeight="Normal" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SecondaryButton}"
                                        Height="32"
                                        Padding="10,0"
                                        Margin="10,0,0,0"
                                        Click="BtnHelpClassifierSearch_Click"
                                        ToolTip="Открыть справку и примеры по логике настройки поиска кодов классификатора">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="❓" FontFamily="Segoe UI Emoji" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Справка по поиску кодов" FontSize="12" FontWeight="Normal" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <CheckBox x:Name="ChkSkipAboveGround" Content="Не классифицировать НАДЗЕМНУЮ часть (например, если элемент бывает только подземным)"
                                      FontWeight="SemiBold" Foreground="{StaticResource ApexRed}" Margin="0,0,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Любое слово AnyTrue -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Любое слово (AnyTrue):" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <ItemsControl ItemsSource="{Binding AboveAnyTrueTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource ChipBg}" CornerRadius="12" Padding="10,4,6,4" Margin="0,0,6,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="Medium" Margin="0,0,6,0"/>
                                                    <Button Content="✕" Width="18" Height="18" FontSize="10" FontWeight="Bold"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Foreground="{StaticResource TextSecondary}"
                                                            Tag="{Binding}" Click="RemoveAboveAny_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtAddAboveAny" Height="30" KeyDown="TxtAddAboveAny_KeyDown"/>
                                    <Button Grid.Column="1" Content="+ Добавить" Margin="6,0,0,0" Height="30" Style="{StaticResource SecondaryButton}" Click="BtnAddAboveAny_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Все слова AllTrue -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Все слова (AllTrue):" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <ItemsControl ItemsSource="{Binding AboveAllTrueTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource ChipBg}" CornerRadius="12" Padding="10,4,6,4" Margin="0,0,6,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="Medium" Margin="0,0,6,0"/>
                                                    <Button Content="✕" Width="18" Height="18" FontSize="10" FontWeight="Bold"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Foreground="{StaticResource TextSecondary}"
                                                            Tag="{Binding}" Click="RemoveAboveAll_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtAddAboveAll" Height="30" KeyDown="TxtAddAboveAll_KeyDown"/>
                                    <Button Grid.Column="1" Content="+ Добавить" Margin="6,0,0,0" Height="30" Style="{StaticResource SecondaryButton}" Click="BtnAddAboveAll_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Исключения Exceptions -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Исключения (Exceptions):" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="4" Grid.Column="1">
                                <ItemsControl ItemsSource="{Binding AboveExceptionsTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FEE2E2" CornerRadius="12" Padding="10,4,6,4" Margin="0,0,6,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="Medium" Foreground="#DC2626" Margin="0,0,6,0"/>
                                                    <Button Content="✕" Width="18" Height="18" FontSize="10" FontWeight="Bold"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Foreground="#DC2626"
                                                            Tag="{Binding}" Click="RemoveAboveExc_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtAddAboveExc" Height="30" KeyDown="TxtAddAboveExc_KeyDown"/>
                                    <Button Grid.Column="1" Content="+ Добавить" Margin="6,0,0,0" Height="30" Style="{StaticResource SecondaryButton}" Click="BtnAddAboveExc_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Бонусные слова (ExtraTrue) со столбцами Слово / Баллы -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Бонусные баллы (ExtraTrue):" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="6" Grid.Column="1">
                                <ItemsControl ItemsSource="{Binding AboveBonusRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F4F4F5" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Word}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Points, StringFormat='{}+{0} балл.'}" Foreground="{StaticResource ApexRed}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Content="✕" Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Tag="{Binding}" Click="RemoveAboveBonus_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtAboveBonusWord" Height="30" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1" x:Name="TxtAboveBonusPoints" Text="1" TextAlignment="Center" Height="30" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Content="+ Добавить балл" Height="30" Style="{StaticResource SecondaryButton}" Click="BtnAddAboveBonus_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                            <!-- Панель проверки того, что найдётся по правилам надземной части -->
                            <Border Margin="0,18,0,0" Background="#F8FAFC" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="🔍 Проверить, что найдётся"
                                                Height="34" Padding="16,0"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="BtnCheckAboveMatches_Click"/>
                                    </StackPanel>

                                    <!-- Отображение списка найденного в том же виде, как на главной странице -->
                                    <Border Margin="0,10,0,0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedAbovePreviewPath}"
                                                       FontSize="11" Foreground="#64748B"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="2,0,0,4"/>
                                            <ComboBox Height="30"
                                                      ItemsSource="{Binding AbovePreviewMatches}"
                                                      SelectedItem="{Binding SelectedAbovePreviewMatch, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>
                                            <TextBlock Text="⚠️ ВНИМАНИЕ: выбранный код имеет дочерние (вложенные) уровни! Настоятельно рекомендуется добавить бонусные баллы за уточняющие слова, чтобы выбрать более точное (конечное) значение классификатора." 
                                                       Foreground="{StaticResource ApexRed}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,8,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAboveWarning}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ═══ ВКЛАДКА 3: Код для подземной части ══════════════════════ -->
            <TabItem x:Name="TabBelowGround" Header="Код для подземной части">
                <Border Background="{StaticResource SurfaceWhite}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,6,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,12,0">
                            <!-- Кнопки копирования и справки над всеми настройками вкладки -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,14">
                                <Button x:Name="BtnCopyBelowToAbove"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="32"
                                        Padding="10,0"
                                        Click="BtnCopyBelowToAbove_Click"
                                        ToolTip="Скопировать все списки ключевых слов (AnyTrue, AllTrue, Исключения) и таблицу баллов из этой вкладки во вкладку «Код для надземной части»">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📋" FontFamily="Segoe UI Emoji" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="→ Надземная часть" FontSize="12" FontWeight="Normal" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SecondaryButton}"
                                        Height="32"
                                        Padding="10,0"
                                        Margin="10,0,0,0"
                                        Click="BtnHelpClassifierSearch_Click"
                                        ToolTip="Открыть справку и примеры по логике настройки поиска кодов классификатора">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="❓" FontFamily="Segoe UI Emoji" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Справка по поиску кодов" FontSize="12" FontWeight="Normal" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <CheckBox x:Name="ChkSkipUnderground" Content="Не классифицировать ПОДЗЕМНУЮ часть (например, если элемент бывает только надземным)"
                                      FontWeight="SemiBold" Foreground="{StaticResource ApexRed}" Margin="0,0,0,14"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Любое слово AnyTrue -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Любое слово (AnyTrue):" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <ItemsControl ItemsSource="{Binding BelowAnyTrueTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource ChipBg}" CornerRadius="12" Padding="10,4,6,4" Margin="0,0,6,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="Medium" Margin="0,0,6,0"/>
                                                    <Button Content="✕" Width="18" Height="18" FontSize="10" FontWeight="Bold"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Foreground="{StaticResource TextSecondary}"
                                                            Tag="{Binding}" Click="RemoveBelowAny_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtAddBelowAny" Height="30" KeyDown="TxtAddBelowAny_KeyDown"/>
                                    <Button Grid.Column="1" Content="+ Добавить" Margin="6,0,0,0" Height="30" Style="{StaticResource SecondaryButton}" Click="BtnAddBelowAny_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Все слова AllTrue -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Все слова (AllTrue):" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <ItemsControl ItemsSource="{Binding BelowAllTrueTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource ChipBg}" CornerRadius="12" Padding="10,4,6,4" Margin="0,0,6,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="Medium" Margin="0,0,6,0"/>
                                                    <Button Content="✕" Width="18" Height="18" FontSize="10" FontWeight="Bold"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Foreground="{StaticResource TextSecondary}"
                                                            Tag="{Binding}" Click="RemoveBelowAll_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtAddBelowAll" Height="30" KeyDown="TxtAddBelowAll_KeyDown"/>
                                    <Button Grid.Column="1" Content="+ Добавить" Margin="6,0,0,0" Height="30" Style="{StaticResource SecondaryButton}" Click="BtnAddBelowAll_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Исключения Exceptions -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Исключения (Exceptions):" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="4" Grid.Column="1">
                                <ItemsControl ItemsSource="{Binding BelowExceptionsTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FEE2E2" CornerRadius="12" Padding="10,4,6,4" Margin="0,0,6,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="Medium" Foreground="#DC2626" Margin="0,0,6,0"/>
                                                    <Button Content="✕" Width="18" Height="18" FontSize="10" FontWeight="Bold"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            Foreground="#DC2626"
                                                            Tag="{Binding}" Click="RemoveBelowExc_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtAddBelowExc" Height="30" KeyDown="TxtAddBelowExc_KeyDown"/>
                                    <Button Grid.Column="1" Content="+ Добавить" Margin="6,0,0,0" Height="30" Style="{StaticResource SecondaryButton}" Click="BtnAddBelowExc_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Бонусные слова (ExtraTrue) со столбцами Слово / Баллы -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Бонусные баллы (ExtraTrue):" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Grid.Row="6" Grid.Column="1">
                                <ItemsControl ItemsSource="{Binding BelowBonusRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F4F4F5" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="30"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Word}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Points, StringFormat='{}+{0} балл.'}" Foreground="{StaticResource ApexRed}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Content="✕" Width="20" Height="20" Background="Transparent" BorderThickness="0" Cursor="Hand" Tag="{Binding}" Click="RemoveBelowBonus_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtBelowBonusWord" Height="30" Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1" x:Name="TxtBelowBonusPoints" Text="100" TextAlignment="Center" Height="30" Margin="0,0,6,0"/>
                                    <Button Grid.Column="2" Content="+ Добавить балл" Height="30" Style="{StaticResource SecondaryButton}" Click="BtnAddBelowBonus_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                            <!-- Панель проверки того, что найдётся по правилам подземной части -->
                            <Border Margin="0,18,0,0" Background="#F8FAFC" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="🔍 Проверить, что найдётся"
                                                Height="34" Padding="16,0"
                                                Style="{StaticResource SecondaryButton}"
                                                Click="BtnCheckBelowMatches_Click"/>
                                    </StackPanel>

                                    <!-- Отображение списка найденного в том же виде, как на главной странице -->
                                    <Border Margin="0,10,0,0" Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedBelowPreviewPath}"
                                                       FontSize="11" Foreground="#64748B"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="2,0,0,4"/>
                                            <ComboBox Height="30"
                                                      ItemsSource="{Binding BelowPreviewMatches}"
                                                      SelectedItem="{Binding SelectedBelowPreviewMatch, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Stretch"
                                                      HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>
                                            <TextBlock Text="⚠️ ВНИМАНИЕ: выбранный код имеет дочерние (вложенные) уровни! Настоятельно рекомендуется добавить бонусные баллы за уточняющие слова, чтобы выбрать более точное (конечное) значение классификатора." 
                                                       Foreground="{StaticResource ApexRed}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,8,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBelowWarning}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

        </TabControl>

        <!-- 3. Нижние кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Отмена" Width="110" Height="34" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="BtnCancel_Click"/>
            <Button Content="Сохранить" Width="120" Height="34" Style="{StaticResource PrimaryButton}" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
