<Window x:Class="AssemblyCodePlugin.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заполнение кодификатора по правилам (Antigravity)" Height="680" Width="1060"
        WindowStartupLocation="CenterScreen" Background="#F4F4F5" Foreground="#18181B"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Цветовая палитра из RevisionViewer -->
        <SolidColorBrush x:Key="ApexRed"       Color="#E23E2E"/>
        <SolidColorBrush x:Key="ApexRedDark"   Color="#C0342A"/>
        <SolidColorBrush x:Key="BorderColor"   Color="#D4D4D8"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#71717A"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#18181B"/>
        <SolidColorBrush x:Key="SurfaceWhite"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HeaderBg"      Color="#FAFAFA"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E4E7"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ApexRed}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ApexRedDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E4E4E7"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ApexRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E4E4E7"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ApexRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F4F4F5"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ApexRed}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E4E4E7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VerifyButton" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0369A1"/>
            <Setter Property="Background" Value="#E0F2FE"/>
            <Setter Property="BorderBrush" Value="#BAE6FD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#BAE6FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель управления конфигурациями -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceWhite}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <!-- Левая часть: Выбор и операции с конфигурациями -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Конфигурация:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#0F172A"/>
                    <ComboBox x:Name="CmbConfigs" SelectionChanged="CmbConfigs_SelectionChanged" Width="210" Height="33" Margin="0,0,16,0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Padding="8,0,0,0"/>

                    <Button x:Name="BtnNewConfig" Content="➕ Создать" Style="{StaticResource ToolButton}" Height="33" Margin="0,0,10,0" Click="BtnNewConfig_Click" ToolTip="Создать новую конфигурацию на основе текущей"/>
                    <Button x:Name="BtnRenameConfig" Content="✏️ Переименовать" Style="{StaticResource ToolButton}" Height="33" Margin="0,0,10,0" Click="BtnRenameConfig_Click"/>
                    <Button x:Name="BtnDeleteConfig" Content="🗑 Удалить" Style="{StaticResource ToolButton}" Height="33" Click="BtnDeleteConfig_Click"/>
                </StackPanel>

                <!-- Правая часть: Импорт и экспорт -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnImportConfig" Content="📥 Импорт..." Style="{StaticResource ToolButton}" Height="33" Margin="0,0,10,0" Click="BtnImportConfig_Click" ToolTip="Загрузить конфигурацию из JSON-файла"/>
                    <Button x:Name="BtnExportConfig" Content="📤 Экспорт..." Style="{StaticResource ToolButton}" Height="33" Click="BtnExportConfig_Click" ToolTip="Сохранить текущую конфигурацию в JSON-файл"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Верхняя карточка: Настройки уровней нуля и параметров -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceWhite}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Нижний ноль:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbLowLevel"/>
                <TextBox Grid.Row="0" Grid.Column="2" x:Name="TxtLowOffset" Margin="6,0,0,0" ToolTip="Смещение (мм)"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="Верхний ноль:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox Grid.Row="0" Grid.Column="5" x:Name="CmbHighLevel"/>
                <TextBox Grid.Row="0" Grid.Column="6" x:Name="TxtHighOffset" Margin="6,0,0,0" ToolTip="Смещение (мм)"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Парам. кода:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondary}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TxtAssemblyParam"/>

                <TextBlock Grid.Row="2" Grid.Column="4" Text="Парам. зоны:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondary}"/>
                <TextBox Grid.Row="2" Grid.Column="5" Grid.ColumnSpan="2" x:Name="TxtUndergroundParam"/>

                <!-- Общая настройка суффикса BGL -->
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="8" Orientation="Vertical" Margin="0,2,0,0">
                    <CheckBox x:Name="ChkNeverAddBglSuffix"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center">
                        <TextBlock Text="Не добавлять суффикс _BGL для подземной части"
                                   FontWeight="SemiBold"
                                   Foreground="#1E293B"/>
                    </CheckBox>
                    <TextBlock FontSize="11"
                               Foreground="#64748B"
                               TextWrapping="Wrap"
                               Margin="22,3,0,0">
                        <Run Text="Для случаев, когда:" FontWeight="Medium"/>
                        <LineBreak/>
                        <Run Text="1. Код по классификатору и индентификатор надземной/подземной части здания записываются в параметры экземпляра."/>
                        <LineBreak/>
                        <Run Text="2. Код по классификатору индентичен для надземной и подземной части здания, а индентификатор надземной/подземной части здания записывается в параметры экземпляра."/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Центральная область: Таблица правил и аккуратная нижняя панель инструментов -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Таблица правил с колонками классификатора и выбором -->
            <DataGrid Grid.Row="0" x:Name="GridRules" MouseDoubleClick="GridRules_DoubleClick" PreviewKeyDown="GridRules_PreviewKeyDown" RowHeight="58">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E0F2FE"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E0F2FE"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColType" Header="Тип элемента" Binding="{Binding ElementTypeName}" Width="160" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Margin" Value="6,4"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                    <!-- Классификатор надземной части -->
                    <DataGridTemplateColumn x:Name="ColAbove" Header="Классификатор надземной части" Width="340">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="CellBorder" CornerRadius="4" Padding="4,3" Margin="3,2" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding SelectedAbovePath}"
                                                   FontSize="10.5" Foreground="#64748B"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Left"
                                                   Margin="2,0,0,2"/>
                                        <ComboBox x:Name="Combo"
                                                  Height="26"
                                                  ItemsSource="{Binding AboveMatches}" SelectedItem="{Binding SelectedAboveMatch, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsAboveActive}"
                                                  BorderThickness="0" Background="Transparent"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsAboveActive}" Value="False">
                                        <Setter TargetName="CellBorder" Property="Background" Value="#F1F5F9"/>
                                        <Setter TargetName="Combo" Property="Foreground" Value="#94A3B8"/>
                                        <Setter TargetName="Combo" Property="Opacity" Value="0.65"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAboveMatchNotFound}" Value="True">
                                        <Setter TargetName="Combo" Property="Foreground" Value="#DC2626"/>
                                        <Setter TargetName="Combo" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Классификатор подземной части -->
                    <DataGridTemplateColumn x:Name="ColBelow" Header="Классификатор подземной части" Width="340">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="CellBorder" CornerRadius="4" Padding="4,3" Margin="3,2" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding SelectedBelowPath}"
                                                   FontSize="10.5" Foreground="#64748B"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Left"
                                                   Margin="2,0,0,2"/>
                                        <ComboBox x:Name="Combo"
                                                  Height="26"
                                                  ItemsSource="{Binding BelowMatches}" SelectedItem="{Binding SelectedBelowMatch, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsBelowActive}"
                                                  BorderThickness="0" Background="Transparent"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsBelowActive}" Value="False">
                                        <Setter TargetName="CellBorder" Property="Background" Value="#F1F5F9"/>
                                        <Setter TargetName="Combo" Property="Foreground" Value="#94A3B8"/>
                                        <Setter TargetName="Combo" Property="Opacity" Value="0.65"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBelowMatchNotFound}" Value="True">
                                        <Setter TargetName="Combo" Property="Foreground" Value="#DC2626"/>
                                        <Setter TargetName="Combo" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Отбор в Revit в одну строку через точку с запятой с цветными значениями -->
                    <DataGridTemplateColumn Header="Отбор в Revit" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding FilterTokens}" VerticalAlignment="Center" Margin="4,2">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                                <Run Text="{Binding Label}" Foreground="#334155"/>
                                                <Run Text="{Binding Value}" Foreground="#047857" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Аккуратная панель инструментов под таблицей (векторные цветные иконки) -->
            <Border Grid.Row="1" Margin="0,8,0,0" Padding="8,6" Background="{StaticResource SurfaceWhite}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая группа: Операции со строками и порядком -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" ToolTip="Добавить новое правило" Click="BtnAdd_Click">
                            <TextBlock Text="➕" FontFamily="Segoe UI Emoji" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Изменить выбранное правило" Click="BtnEdit_Click">
                            <TextBlock Text="✏️" FontFamily="Segoe UI Emoji" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Копировать выбранное правило" Click="BtnCopy_Click">
                            <TextBlock Text="📋" FontFamily="Segoe UI Emoji" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Margin="0,0,14,0" ToolTip="Удалить выбранное правило" Click="BtnDelete_Click">
                            <TextBlock Text="🗑️" FontFamily="Segoe UI Emoji" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>

                        <Rectangle Width="1" Fill="{StaticResource BorderColor}" Margin="0,4,14,4"/>

                        <Button Style="{StaticResource IconButton}" ToolTip="Поднять правило вверх" Click="BtnUp_Click">
                            <TextBlock Text="⬆️" FontFamily="Segoe UI Emoji" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Опустить правило вниз" Click="BtnDown_Click">
                            <TextBlock Text="⬇️" FontFamily="Segoe UI Emoji" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Правая группа: Сброс по умолчанию -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Margin="0" ToolTip="Сбросить все правила к настройкам по умолчанию" Click="BtnReset_Click">
                            <TextBlock Text="🔄" FontFamily="Segoe UI Emoji" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Нижний бар: Строка статуса и Кнопки действий -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="TxtStatus" Text="Готов к проверке и запуску" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Сохранить настройки" Width="150" Height="36" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="BtnSave_Click"/>
                <Button Content="Закрыть" Width="90" Height="36" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="BtnClose_Click"/>
                <Button Content="ЗАПУСТИТЬ" Width="130" Height="36" Style="{StaticResource PrimaryButton}" Click="BtnRun_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
