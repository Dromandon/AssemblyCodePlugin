<Window x:Class="AssemblyCodePlugin.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заполнение кодификатора по правилам (Antigravity)" Height="680" Width="1060"
        WindowStartupLocation="CenterScreen" Background="#F4F4F5" Foreground="#18181B"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Цветовая палитра из RevisionViewer -->
        <SolidColorBrush x:Key="ApexRed"       Color="#E23E2E"/>
        <SolidColorBrush x:Key="ApexRedDark"   Color="#C0342A"/>
        <SolidColorBrush x:Key="BorderColor"   Color="#D4D4D8"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#71717A"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#18181B"/>
        <SolidColorBrush x:Key="SurfaceWhite"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="HeaderBg"      Color="#FAFAFA"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E4E4E7"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource HeaderBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource ApexRed}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ApexRedDark}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E4E4E7"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ApexRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E4E4E7"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ApexRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F4F4F5"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ApexRed}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E4E4E7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VerifyButton" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0369A1"/>
            <Setter Property="Background" Value="#E0F2FE"/>
            <Setter Property="BorderBrush" Value="#BAE6FD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#BAE6FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FeedbackButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Сам тумблер (Пилюля 38x22) -->
                            <Grid Width="38" Height="22" Margin="0,0,10,0">
                                <Border x:Name="Track" CornerRadius="11" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1"/>
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.2"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                            <!-- Подпись рядом -->
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#0EA5E9"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#0284C7"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель управления конфигурациями -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceWhite}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <!-- Левая часть: Выбор и операции с конфигурациями -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Конфигурация:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#0F172A"/>
                    <ComboBox x:Name="CmbConfigs" SelectionChanged="CmbConfigs_SelectionChanged" Width="210" Height="33" Margin="0,0,16,0" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Padding="8,0,0,0"/>

                    <Button x:Name="BtnNewConfig" Content="➕ Создать" Style="{StaticResource ToolButton}" Height="33" Margin="0,0,10,0" Click="BtnNewConfig_Click" ToolTip="Создать новую конфигурацию на основе текущей"/>
                    <Button x:Name="BtnRenameConfig" Content="✏️ Переименовать" Style="{StaticResource ToolButton}" Height="33" Margin="0,0,10,0" Click="BtnRenameConfig_Click"/>
                    <Button x:Name="BtnDeleteConfig" Content="🗑 Удалить" Style="{StaticResource ToolButton}" Height="33" Click="BtnDeleteConfig_Click"/>
                </StackPanel>

                <!-- Правая часть: Импорт и экспорт -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnImportConfig" Content="📥 Импорт..." Style="{StaticResource ToolButton}" Height="33" Margin="0,0,10,0" Click="BtnImportConfig_Click" ToolTip="Загрузить конфигурацию из JSON-файла"/>
                    <Button x:Name="BtnExportConfig" Content="📤 Экспорт..." Style="{StaticResource ToolButton}" Height="33" Click="BtnExportConfig_Click" ToolTip="Сохранить текущую конфигурацию в JSON-файл"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Верхний блок настроек (Компактная панель) -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceWhite}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
            <StackPanel Orientation="Vertical">
                
                <!-- 1. Тумблер полного отключения зон -->
                <StackPanel Margin="0,0,0,16">
                    <CheckBox x:Name="ChkDisableZoneSplit" Style="{StaticResource ToggleSwitchStyle}" VerticalAlignment="Center" Click="ChkDisableZoneSplit_Click">
                        <TextBlock Text="Не делить элементы на выше и ниже нуля" FontWeight="Bold" Foreground="#E23E2E"/>
                    </CheckBox>
                </StackPanel>

                <!-- Основные настройки: параметры и отметки нуля -->
                <Grid Margin="0,0,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Строка 0: Параметр кода и Кнопка идентификатора -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="65"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Параметр кода:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#334155" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" Grid.ColumnSpan="2" x:Name="CmbAssemblyCodeParam" IsEditable="True" Height="26" 
                                  SelectionChanged="CmbAssemblyCodeParam_SelectionChanged"
                                  TextBoxBase.TextChanged="CmbAssemblyCodeParam_TextChanged" Margin="0,0,6,0"/>

                        <Button Grid.Column="4" Grid.ColumnSpan="3" x:Name="BtnConfigureUndergroundId"
                                HorizontalAlignment="Stretch"
                                Content="⚙️ Идентификатор зоны..."
                                Style="{StaticResource ToolButton}" Height="26"
                                Click="BtnConfigureUndergroundId_Click"
                                ToolTip="Настроить параметр и значения для надземной и подземной части"/>
                    </Grid>

                    <!-- Строка 1: Параметр описания (скрытый) -->
                    <StackPanel Grid.Row="1" x:Name="PanelAssemblyDescParam" Orientation="Horizontal" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="Параметр описания:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#334155" Width="120"/>
                        <ComboBox x:Name="CmbAssemblyDescParam" IsEditable="True" Height="26" Width="189"/>
                    </StackPanel>

                    <!-- Строка 2: Блок отметок нуля -->
                    <StackPanel Grid.Row="2" x:Name="ZeroLevelSettingsPanel" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Нижний ноль:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#334155" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" x:Name="CmbLowLevel" Height="26" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="2" x:Name="TxtLowOffset" Height="26" ToolTip="Смещение (мм)" Padding="4,2"/>

                            <TextBlock Grid.Column="4" Text="Верхний ноль:" VerticalAlignment="Center" FontWeight="Medium" Foreground="#334155" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="5" x:Name="CmbHighLevel" Height="26" Margin="0,0,6,0"/>
                            <TextBox Grid.Column="6" x:Name="TxtHighOffset" Height="26" ToolTip="Смещение (мм)" Padding="4,2"/>
                        </Grid>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </Border>

        <!-- Центральная область: Таблица правил и аккуратная нижняя панель инструментов -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Таблица правил с колонками классификатора и выбором -->
            <DataGrid Grid.Row="0" x:Name="GridRules" MouseDoubleClick="GridRules_DoubleClick" PreviewKeyDown="GridRules_PreviewKeyDown" RowHeight="58">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E0F2FE"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E0F2FE"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColType" Header="Тип элемента" Binding="{Binding ElementTypeName}" Width="160" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Margin" Value="6,4"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Классификатор надземной части -->
                    <DataGridTemplateColumn x:Name="ColAbove" Header="Классификатор надземной части" Width="340">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="CellBorder" CornerRadius="4" Padding="4,3" Margin="3,2" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding SelectedAbovePath}"
                                                   FontSize="10.5" Foreground="#64748B"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Left"
                                                   Margin="2,0,0,2"/>
                                        <ComboBox x:Name="Combo"
                                                  Height="26"
                                                  ItemsSource="{Binding AboveMatches}" SelectedItem="{Binding SelectedAboveMatch, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsAboveActive}"
                                                  BorderThickness="0" Background="Transparent"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsAboveActive}" Value="False">
                                        <Setter TargetName="CellBorder" Property="Background" Value="#F1F5F9"/>
                                        <Setter TargetName="Combo" Property="Foreground" Value="#94A3B8"/>
                                        <Setter TargetName="Combo" Property="Opacity" Value="0.65"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAboveMatchNotFound}" Value="True">
                                        <Setter TargetName="Combo" Property="Foreground" Value="#DC2626"/>
                                        <Setter TargetName="Combo" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Классификатор подземной части -->
                    <DataGridTemplateColumn x:Name="ColBelow" Header="Классификатор подземной части" Width="340">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="CellBorder" CornerRadius="4" Padding="4,3" Margin="3,2" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{Binding SelectedBelowPath}"
                                                   FontSize="10.5" Foreground="#64748B"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Left"
                                                   Margin="2,0,0,2"/>
                                        <ComboBox x:Name="Combo"
                                                  Height="26"
                                                  ItemsSource="{Binding BelowMatches}" SelectedItem="{Binding SelectedBelowMatch, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsBelowActive}"
                                                  BorderThickness="0" Background="Transparent"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsBelowActive}" Value="False">
                                        <Setter TargetName="CellBorder" Property="Background" Value="#F1F5F9"/>
                                        <Setter TargetName="Combo" Property="Foreground" Value="#94A3B8"/>
                                        <Setter TargetName="Combo" Property="Opacity" Value="0.65"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBelowMatchNotFound}" Value="True">
                                        <Setter TargetName="Combo" Property="Foreground" Value="#DC2626"/>
                                        <Setter TargetName="Combo" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Отбор в Revit в одну строку через точку с запятой с цветными значениями -->
                    <DataGridTemplateColumn Header="Отбор в Revit" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding FilterTokens}" VerticalAlignment="Center" Margin="4,2">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                                <Run Text="{Binding Label}" Foreground="#334155"/>
                                                <Run Text="{Binding Value}" Foreground="#047857" FontWeight="SemiBold"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Аккуратная панель инструментов под таблицей (векторные цветные иконки) -->
            <Border Grid.Row="1" Margin="0,8,0,0" Padding="8,6" Background="{StaticResource SurfaceWhite}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Левая группа: Операции со строками и порядком -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" ToolTip="Добавить новое правило" Click="BtnAdd_Click">
                            <TextBlock Text="➕" FontFamily="Segoe UI Emoji" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Изменить выбранное правило" Click="BtnEdit_Click">
                            <TextBlock Text="✏️" FontFamily="Segoe UI Emoji" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Копировать выбранное правило" Click="BtnCopy_Click">
                            <TextBlock Text="📋" FontFamily="Segoe UI Emoji" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Margin="0,0,14,0" ToolTip="Удалить выбранное правило" Click="BtnDelete_Click">
                            <TextBlock Text="🗑️" FontFamily="Segoe UI Emoji" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>

                        <Rectangle Width="1" Fill="{StaticResource BorderColor}" Margin="0,4,14,4"/>

                        <Button Style="{StaticResource IconButton}" ToolTip="Поднять правило вверх" Click="BtnUp_Click">
                            <TextBlock Text="⬆️" FontFamily="Segoe UI Emoji" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Опустить правило вниз" Click="BtnDown_Click">
                            <TextBlock Text="⬇️" FontFamily="Segoe UI Emoji" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

        <!-- Нижний бар: Строка статуса и Кнопки действий -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatus" Text="Готов к проверке и запуску" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,14,0"/>

                <Rectangle Width="1" Height="18" Fill="{StaticResource BorderColor}" Margin="0,0,14,0"/>

                <TextBlock Text="Обратная связь:" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <!-- Кнопка 1: Apex -->
                <Button Style="{StaticResource FeedbackButton}" Height="30" Padding="8,0" Margin="0,0,8,0"
                        Click="BtnOpenApexMessenger_Click" Cursor="Hand"
                        ToolTip="Написать в корпоративный мессенджер Apex (@mikhail.davtyan)" Width="71">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Иконка Apex (кольцо с вертикальным штрихом справа) -->
                        <Viewbox Width="18" Height="18" Margin="0,0,6,0">
                            <Canvas Width="24" Height="24">
                                <Ellipse Width="21" Height="21" Stroke="#E23E2E" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center" Canvas.Top="1" Canvas.Left="2"/>
                                <Rectangle Canvas.Left="21" Canvas.Top="11" Width="2" Height="11" Fill="#E23E2E" RadiusX="1.6" RadiusY="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Apex" FontSize="12" Foreground="#0F172A" Width="29"/>
                    </StackPanel>
                </Button>

                <!-- Кнопка 2: Telegram -->
                <Button Style="{StaticResource FeedbackButton}" Height="30" Padding="8,0"
                        Click="BtnOpenTelegram_Click" Cursor="Hand"
                        ToolTip="Написать в Telegram (@Dromandon)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Иконка Telegram -->
                        <Viewbox Width="18" Height="18" Margin="0,0,6,0">
                            <Canvas Width="24" Height="24">
                                <Ellipse Width="24" Height="24" Fill="#2AABEE"/>
                                <Path Fill="White" Data="M 18.38,5.78 C 18.95,5.55 19.46,5.98 19.28,6.85 L 17.03,17.43 C 16.86,18.2 16.39,18.4 15.75,18.04 L 12.2,15.42 L 10.49,17.07 C 10.3,17.26 10.14,17.42 9.77,17.42 L 10.02,13.8 L 16.63,7.84 C 16.92,7.58 16.56,7.43 16.18,7.69 L 8.01,12.83 L 4.5,11.73 C 3.73,11.49 3.72,10.73 4.66,10.36 L 18.38,5.78 Z" HorizontalAlignment="Center" VerticalAlignment="Center" Canvas.Left="-0.777"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Telegram" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Сохранить настройки" Width="150" Height="36" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="BtnSave_Click"/>
                <Button Content="Закрыть" Width="90" Height="36" Margin="0,0,10,0" Style="{StaticResource SecondaryButton}" Click="BtnClose_Click"/>
                <Button Content="ЗАПУСТИТЬ" Width="130" Height="36" Style="{StaticResource PrimaryButton}" Click="BtnRun_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
