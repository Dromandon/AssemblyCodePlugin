<Window x:Class="AssemblyCodePlugin.UI.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчет кодификатора (Antigravity)"
        Width="920" Height="620"
        MinWidth="700" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Segoe UI Emoji">

    <Window.Resources>
        <!-- Цвета -->
        <SolidColorBrush x:Key="SurfaceWhite" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#0284C7"/>
        <SolidColorBrush x:Key="AccentBlueHover" Color="#0369A1"/>

        <!-- Стили кнопок -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HighlightButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Foreground" Value="#0369A1"/>
            <Setter Property="Background" Value="#E0F2FE"/>
            <Setter Property="BorderBrush" Value="#BAE6FD"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighlightActive}" Value="True">
                    <Setter Property="Foreground" Value="#B91C1C"/>
                    <Setter Property="Background" Value="#FEE2E2"/>
                    <Setter Property="BorderBrush" Value="#FECACA"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя карточка сводки -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceWhite}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtSummaryTitle" Text="Кодификация завершена" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtSummaryDetails" Text="Обработано элементов: 0" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="BtnOpenLog" Content="📄 Открыть лог" Style="{StaticResource ToolButton}" Margin="0" Click="BtnOpenLog_Click"/>
            </Grid>
        </Border>

        <!-- Вкладки со списками элементов -->
        <TabControl Grid.Row="1" x:Name="TabsMain" Background="Transparent" BorderThickness="0">
            <TabItem x:Name="TabUnassigned" Header="❌ Без кода (0)" FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,8,0,0">
                    <DataGrid x:Name="GridUnassigned" SelectionMode="Extended">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0F2FE"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ElementId}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Тип / Семейство" Binding="{Binding TypeName}" Width="200" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Причина" Binding="{Binding Details}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabSpanning" Header="⚠️ Пересекают ноль (0)" FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,8,0,0">
                    <DataGrid x:Name="GridSpanning" SelectionMode="Extended">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0F2FE"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ElementId}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Тип / Семейство" Binding="{Binding TypeName}" Width="200" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Примечание" Binding="{Binding Details}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabGrouped" Header="📦 В группах (0)" FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,8,0,0">
                    <DataGrid x:Name="GridGrouped" SelectionMode="Extended">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0F2FE"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ElementId}" Width="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Тип / Семейство" Binding="{Binding TypeName}" Width="200" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Причина" Binding="{Binding Details}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Нижняя панель действий -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="12,10" Background="{StaticResource SurfaceWhite}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnSelectInRevit" Content="🎯 Выделить в Revit" Style="{StaticResource ToolButton}" Click="BtnSelectInRevit_Click"/>
                <Button Grid.Column="1" x:Name="BtnShowIn3D" Content="🔍 Показать на 3D" Style="{StaticResource ToolButton}" Click="BtnShowIn3D_Click"/>
                <Button Grid.Column="2" x:Name="BtnToggleHighlight" Content="💡 Подсветить на 3D" Style="{StaticResource HighlightButton}" Click="BtnToggleHighlight_Click"/>

                <Button Grid.Column="4" x:Name="BtnClose" Content="Закрыть" Style="{StaticResource ToolButton}" Margin="0" Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
